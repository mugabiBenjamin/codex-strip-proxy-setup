#!/usr/bin/env python3
"""Preview, apply, or restore the selected provider's base_url."""
import argparse
import json
from pathlib import Path
import sys

PACKAGE_ROOT = Path(__file__).resolve().parent.parent
if str(PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(PACKAGE_ROOT))

from src.config_editor import change
from src.env import config_path
from src.manifest import DEFAULT_PORT


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, default=config_path())
    parser.add_argument('--port', type=int, default=DEFAULT_PORT)
    parser.add_argument('--mode', choices=['check', 'apply', 'restore'], default='check')
    args = parser.parse_args()
    try:
        print(json.dumps(change(args.config, args.port, args.mode), indent=2))
    except (OSError, ValueError, KeyError) as error:
        print('STOP: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
